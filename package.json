{
  "name": "antigravity-native-addon-host",
  "version": "2.2.0",
  "description": "Vendor-independent native desktop addon host and shared plugin isolation contract (AddonManifest v1/v2) for Electron apps, with Antigravity Desktop as the default profile.",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "addon-host": "bin/addon-host.js"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.js",
    "check:runtime": "node scripts/build-runtime.js --check",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/e2e/electron-real-runtime.test.js\"",
    "test:e2e:isolated": "node scripts/e2e-isolated-runtime.cjs",
    "test:all": "npm run check:runtime && npm test && npm run test:e2e:isolated",
    "status": "node ./bin/addon-host.js --status",
    "doctor": "node ./bin/addon-host.js --doctor"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaeseongs95/antigravity-native-addon-host.git"
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "acorn": "^8.19.0",
    "ajv": "^8.17.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "electron": "^45.4.1"
  }
}
