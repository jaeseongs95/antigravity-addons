{
  "name": "extenra",
  "version": "3.3.0",
  "description": "Extenra — Vendor-independent API-First native desktop & remote web addon host framework (AddonManifest v1/v2/v3, 3-Tier AddonContextV3, dual-key net.fetch, zero-dependency staged runtime, Shadow DOM isolation, SHA-256 trust pinning).",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "extenra": "bin/addon-host.js",
    "addon-host": "bin/addon-host.js",
    "antigravity-addons": "bin/addon-host.js"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.js",
    "check:runtime": "node scripts/build-runtime.js --check",
    "build:remote": "node scripts/build-remote.js",
    "check:remote": "node scripts/build-remote.js --no-addons --check",
    "build:hub": "node scripts/build-hub.js",
    "check:hub": "node scripts/build-hub.js --check",
    "check:solid": "node scripts/check-solid-zero.js",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/e2e/electron-real-runtime.test.js\"",
    "test:e2e:remote": "node --test \"test/e2e/v23-remote-web-chromium.test.js\" \"test/e2e/v30-api-first-chromium.test.js\"",
    "test:e2e:isolated": "node scripts/e2e-isolated-runtime.cjs",
    "test:all": "npm run check:solid && npm run check:runtime && npm run check:remote && npm run check:hub && npm test && npm run test:e2e:remote && npm run test:e2e:isolated",
    "status": "node ./bin/addon-host.js --status",
    "doctor": "node ./bin/addon-host.js --doctor"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaeseongs95/extenra.git"
  },
  "homepage": "https://github.com/jaeseongs95/extenra#readme",
  "bugs": {
    "url": "https://github.com/jaeseongs95/extenra/issues"
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "acorn": "^8.19.0",
    "ajv": "^8.17.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "electron": "^45.4.1"
  }
}
