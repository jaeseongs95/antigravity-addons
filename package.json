{
  "name": "antigravity-addons",
  "version": "2.8.0",
  "description": "Vendor-independent native desktop & remote web addon host framework and shared plugin isolation contract (AddonManifest v1/v2) with zero-dependency staged runtime, Shadow DOM isolation, SHA-256 trust pinning, and named-scope Config Bridge.",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "antigravity-addons": "bin/addon-host.js",
    "addon-host": "bin/addon-host.js"
  },
  "scripts": {
    "build:runtime": "node scripts/build-runtime.js",
    "check:runtime": "node scripts/build-runtime.js --check",
    "build:remote": "node scripts/build-remote.js",
    "check:remote": "node scripts/build-remote.js --no-addons --check",
    "test": "node --test \"test/unit/**/*.test.js\" \"test/e2e/electron-real-runtime.test.js\"",
    "test:e2e:remote": "node --test \"test/e2e/v23-remote-web-chromium.test.js\"",
    "test:e2e:isolated": "node scripts/e2e-isolated-runtime.cjs",
    "test:all": "npm run check:runtime && npm run check:remote && npm test && npm run test:e2e:remote && npm run test:e2e:isolated",
    "status": "node ./bin/addon-host.js --status",
    "doctor": "node ./bin/addon-host.js --doctor"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jaeseongs95/antigravity-addons.git"
  },
  "homepage": "https://github.com/jaeseongs95/antigravity-addons#readme",
  "bugs": {
    "url": "https://github.com/jaeseongs95/antigravity-addons/issues"
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "acorn": "^8.19.0",
    "ajv": "^8.17.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "electron": "^45.4.1"
  }
}
