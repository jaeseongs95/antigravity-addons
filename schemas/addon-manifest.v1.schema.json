{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jaeseongs95/antigravity-native-addon-host/schemas/addon-manifest.v1.schema.json",
  "title": "AddonManifest.v1",
  "description": "Declarative common contract for native desktop plugins hosted without cross-plugin intrusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "displayName",
    "version",
    "capabilities",
    "entry",
    "isolation"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "schemaVersion": {
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostProfile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "minHostVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["renderer", "mainHook"]
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rendererScript": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "mainHookScript": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "uiSlots": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "slotId"],
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "title-bar",
              "sidebar",
              "status-bar",
              "composer-toolbar",
              "settings-pane",
              "aux-pane",
              "modal",
              "overlay",
              "theme",
              "document-transform",
              "custom"
            ]
          },
          "slotId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
          },
          "exclusive": {
            "type": "boolean",
            "default": false
          },
          "scope": {
            "type": "string",
            "enum": ["addon-owned-slot", "native-host-only"],
            "default": "addon-owned-slot"
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noTranslate", "i18nSelfManaged"],
      "properties": {
        "noTranslate": {
          "type": "boolean"
        },
        "i18nSelfManaged": {
          "type": "boolean"
        },
        "respectsNoTranslate": {
          "type": "boolean",
          "default": true
        },
        "storageNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "ipcChannelPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,63}$"
        }
      }
    },
    "loadOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 100
    }
  }
}
