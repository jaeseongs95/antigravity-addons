{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jaeseongs95/antigravity-addons/schemas/addon-manifest.v3.schema.json",
  "title": "AddonManifest.v3",
  "description": "Declarative v3 API-First contract with ISP capability permissions, dual-key net allowlists, service bus ACLs, and 3-Tier host UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pluginId",
    "displayName",
    "version",
    "capabilities",
    "entry"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512
    },
    "schemaVersion": {
      "const": 3
    },
    "apiVersion": {
      "const": 3
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "trustLevel": {
      "type": "string",
      "enum": ["trusted", "restricted"],
      "description": "Declarative trust level. Privileged capabilities still require host trust-policy.json SHA-256 pinning at runtime."
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostProfile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "hostProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          }
        },
        "excludeHostProfiles": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["desktop", "remote-web"]
          }
        },
        "minHostVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["renderer", "mainHook"]
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rendererScript": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "mainHookScript": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rendererSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "mainHookBundleSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "toasts": { "type": "boolean" },
            "dialogs": { "type": "boolean" },
            "overlays": { "type": "boolean" },
            "commands": { "type": "boolean" },
            "statusItems": { "type": "boolean" },
            "settingsPages": { "type": "boolean" },
            "canvas": { "type": "boolean" }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 262144
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subscribe": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{1,95}$"
              }
            },
            "emit": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._:-]{1,95}$"
              }
            }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provide": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{1,63}\\.[a-z0-9][a-z0-9._-]{1,63}$"
                  },
                  "allowedCallers": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^(\\*|[a-z0-9][a-z0-9._-]{1,63})$"
                    }
                  }
                }
              }
            },
            "consume": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}\\.[a-z0-9][a-z0-9._-]{1,63}$"
              }
            }
          }
        },
        "net": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpsHosts": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 4,
                "maxLength": 253
              }
            },
            "userApprovedHttps": {
              "type": "boolean"
            },
            "localLoopback": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 65535
                  },
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
                  }
                ]
              }
            }
          }
        },
        "dom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "documentTransform": { "type": "boolean" },
            "anchors": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              }
            }
          }
        },
        "configBridge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scopes"],
          "properties": {
            "scopes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scopeId", "access"],
                "properties": {
                  "scopeId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{1,31}:[a-z0-9][a-z0-9._-]{1,63}$"
                  },
                  "access": {
                    "type": "string",
                    "enum": ["ro", "rw"]
                  },
                  "maxBytes": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 262144
                  }
                }
              }
            }
          }
        }
      }
    },
    "uiSlots": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "slotId"],
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "title-bar",
              "sidebar",
              "overview-pane",
              "status-bar",
              "composer-toolbar",
              "settings-pane",
              "page-section",
              "aux-pane",
              "modal",
              "overlay",
              "theme",
              "document-transform",
              "custom"
            ]
          },
          "slotId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
          },
          "anchor": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "exclusive": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "enum": ["addon-owned-slot", "native-host-only"]
          },
          "shadow": {
            "type": "boolean"
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noTranslate": {
          "type": "boolean"
        },
        "i18nSelfManaged": {
          "type": "boolean"
        },
        "respectsNoTranslate": {
          "type": "boolean"
        },
        "storageNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "ipcChannelPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,63}$"
        }
      }
    },
    "settingsBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}\\.json$"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      }
    },
    "configBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopes"],
      "properties": {
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scopeId", "access"],
            "properties": {
              "scopeId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,31}:[a-z0-9][a-z0-9._-]{1,63}$"
              },
              "access": {
                "type": "string",
                "enum": ["ro", "rw"]
              },
              "maxBytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 262144
              }
            }
          }
        }
      }
    },
    "loadOrder": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    }
  }
}
